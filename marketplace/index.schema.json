{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nakashireyumi/neuro-desktop/marketplace/index.schema.json",
  "title": "Neuro Desktop marketplace source index v1",
  "description": "Descriptive, pinned upstream listings. No executable installation instructions. validate.py also checks URL credentials, duplicate IDs, license readiness and commit-pinned instructions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "updated_at",
    "repository",
    "branch",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^/?#@]+/[^?#]*$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "description",
          "repository",
          "source_ref",
          "source_commit",
          "license",
          "platforms",
          "game_ids",
          "neuro_api",
          "install",
          "permissions",
          "settings",
          "verification"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "game-integration",
              "tool-bridge",
              "editor-extension",
              "docker-extension"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://[^/?#@]+/[^?#]*$"
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "spdx",
              "status",
              "notes",
              "url"
            ],
            "properties": {
              "spdx": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "standard",
                  "custom",
                  "missing"
                ]
              },
              "notes": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+/[^?#]*$"
              }
            }
          },
          "platforms": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "documented",
              "tested",
              "notes"
            ],
            "properties": {
              "documented": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "windows",
                    "macos",
                    "linux"
                  ]
                },
                "uniqueItems": true
              },
              "tested": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "windows",
                    "macos",
                    "linux"
                  ]
                },
                "uniqueItems": true
              },
              "notes": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "game_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
            },
            "uniqueItems": true
          },
          "neuro_api": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "transport",
              "configuration"
            ],
            "properties": {
              "transport": {
                "const": "websocket"
              },
              "configuration": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "install": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "readiness",
              "instructions_url",
              "requirements",
              "notes"
            ],
            "properties": {
              "mode": {
                "const": "manual"
              },
              "readiness": {
                "type": "string",
                "enum": [
                  "license-review",
                  "upstream-setup-required"
                ]
              },
              "instructions_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://[^/?#@]+/[^?#]*$"
              },
              "requirements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          },
          "permissions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_status",
              "enforcement",
              "capabilities"
            ],
            "properties": {
              "review_status": {
                "const": "inferred-from-source"
              },
              "enforcement": {
                "const": "upstream"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "reason"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "uniqueItems": true
              }
            }
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "upstream_key",
                "type",
                "description"
              ],
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "upstream_key": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "boolean",
                    "integer",
                    "number"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "uniqueItems": true
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reviewed_at",
              "source_links",
              "unverified"
            ],
            "properties": {
              "reviewed_at": {
                "type": "string",
                "format": "date"
              },
              "source_links": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "format": "uri",
                  "pattern": "^https://[^/?#@]+/[^?#]*$"
                }
              },
              "unverified": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
